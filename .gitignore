# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments managed by uv
.venv/

# Local runtime data and databases
# Keep data/ mostly local, but allow small source-of-truth text assets needed by tests/runtime.
data/*
!data/prompts.json
!data/backlog/
data/backlog/*
!data/backlog/archive/
!data/backlog/archive/BACKLOG.md
*.sqlite3
*.sqlite
*.db
.langgraph_api/

# Generated diagrams and local outputs
graph_diagram.png
data/*.png
data/*.hash
data/**/*.png
data/**/*.hash

# Local settings and secrets
data/coding_agent_settings.json
.env
.env.*
!.env.example

# Personal local helper scripts, not project workflow
run
run_*.sh
uv_run.sh

# Logs
logs/
*.log

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
